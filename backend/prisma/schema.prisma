generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Núcleo (Must — Épicas A-C del backlog): cuentas, catálogo de ODS, proyectos y equipo.
// Retos, seguimiento/evaluación y el resto de los módulos se agregan en migraciones
// siguientes conforme el backlog los va priorizando (ver mvp_alcance_backlog.md).

enum AccountType {
  STUDENT
  TEACHER
  ORGANIZATION
  INDEPENDENT
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  ARCHIVED
}

enum ProjectVisibility {
  PUBLIC
  PRIVATE
}

enum TeamRequestRole {
  OWNER
  COLLABORATOR
  TEACHER
  ORGANIZATION
}

enum TeamRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TeamRequestInitiator {
  REQUESTER
  OWNER
}

enum ActivityStatus {
  PENDING
  IN_PROGRESS
  DONE
  OVERDUE
}

enum EvidenceType {
  FILE
  LINK
}

enum DictamenVerdict {
  APPROVED
  CHANGES_REQUESTED
}

model User {
  id           Int         @id @default(autoincrement())
  email        String      @unique
  passwordHash String
  name         String
  accountType  AccountType
  skills       String[]
  interests    String[]
  verified     Boolean     @default(false)
  verifiedAt   DateTime?
  createdAt    DateTime    @default(now())

  ownedProjects        Project[]        @relation("ProjectOwner")
  teachingProjects     Project[]        @relation("ProjectTeacher")
  organizationProjects Project[]        @relation("ProjectOrganization")
  publishedChallenges  Challenge[]      @relation("ChallengeOrganization")
  teamRequests         TeamRequest[]
  ownedActivities      Activity[]       @relation("ActivityOwner")
  assignedActivities   Activity[]       @relation("ActivityAssignee")
  progressUpdates      ProgressUpdate[]
  savedProjects        SavedProject[]
  dictamenesEmitidos   Dictamen[]       @relation("DictamenEvaluator")

  @@map("users")
}

model Sdg {
  id       Int    @id
  name     String
  colorHex String

  projects   ProjectSdg[]
  challenges ChallengeSdg[]

  @@map("sdgs")
}

model Challenge {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  deadline    DateTime?
  createdAt   DateTime  @default(now())

  organizationId Int
  organization   User @relation("ChallengeOrganization", fields: [organizationId], references: [id])

  sdgs     ChallengeSdg[]
  projects Project[]

  @@map("challenges")
}

model ChallengeSdg {
  challengeId Int
  sdgId       Int

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  sdg       Sdg       @relation(fields: [sdgId], references: [id])

  @@id([challengeId, sdgId])
  @@map("challenge_sdgs")
}

model Project {
  id               Int               @id @default(autoincrement())
  name             String
  description      String
  problemStatement String
  objectives       String
  status           ProjectStatus     @default(DRAFT)
  visibility       ProjectVisibility @default(PUBLIC)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  ownerId Int
  owner   User @relation("ProjectOwner", fields: [ownerId], references: [id])

  teacherId Int?
  teacher   User? @relation("ProjectTeacher", fields: [teacherId], references: [id])

  organizationId Int?
  organization   User? @relation("ProjectOrganization", fields: [organizationId], references: [id])

  challengeId Int?
  challenge   Challenge? @relation(fields: [challengeId], references: [id])

  sdgs            ProjectSdg[]
  teamRequests    TeamRequest[]
  activities      Activity[]
  progressUpdates ProgressUpdate[]
  savedBy         SavedProject[]
  dictamenes      Dictamen[]

  @@map("projects")
}

model ProjectSdg {
  projectId Int
  sdgId     Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sdg     Sdg     @relation(fields: [sdgId], references: [id])

  @@id([projectId, sdgId])
  @@map("project_sdgs")
}

model TeamRequest {
  id          Int                   @id @default(autoincrement())
  projectId   Int
  userId      Int
  role        TeamRequestRole
  status      TeamRequestStatus    @default(PENDING)
  initiatedBy TeamRequestInitiator @default(REQUESTER)
  message     String?
  createdAt   DateTime              @default(now())
  resolvedAt  DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@map("team_requests")
}

model Activity {
  id          Int            @id @default(autoincrement())
  projectId   Int
  ownerId     Int
  assigneeId  Int?
  title       String
  description String?
  dueDate     DateTime
  status      ActivityStatus @default(PENDING)
  createdAt   DateTime       @default(now())

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner           User             @relation("ActivityOwner", fields: [ownerId], references: [id])
  assignee        User?            @relation("ActivityAssignee", fields: [assigneeId], references: [id])
  progressUpdates ProgressUpdate[]

  @@map("activities")
}

model ProgressUpdate {
  id           Int      @id @default(autoincrement())
  projectId    Int
  activityId   Int?
  authorId     Int
  text         String
  postedToFeed Boolean  @default(false)
  validated    Boolean  @default(false)
  createdAt    DateTime @default(now())

  project  Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activity Activity?  @relation(fields: [activityId], references: [id])
  author   User       @relation(fields: [authorId], references: [id])
  evidence Evidence[]

  @@map("progress_updates")
}

model SavedProject {
  id        Int      @id @default(autoincrement())
  userId    Int
  projectId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@map("saved_projects")
}

model Evidence {
  id               Int          @id @default(autoincrement())
  progressUpdateId Int
  type             EvidenceType
  url              String
  fileName         String?
  createdAt        DateTime     @default(now())

  progressUpdate ProgressUpdate @relation(fields: [progressUpdateId], references: [id], onDelete: Cascade)

  @@map("evidence")
}

model Dictamen {
  id          Int             @id @default(autoincrement())
  projectId   Int
  evaluatorId Int
  verdict     DictamenVerdict
  comment     String
  createdAt   DateTime        @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evaluator User    @relation("DictamenEvaluator", fields: [evaluatorId], references: [id])

  @@unique([projectId, evaluatorId])
  @@map("dictamenes")
}
